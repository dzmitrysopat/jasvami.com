# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\.jasvami\.by$ [NC]
# RewriteRule ^(.*)$ https://jasvami.by/$1 [R=301,L]
# </IfModule>
